+      (a, b) =>
+        a.hostname === b.hostname &&
+        a.port === b.port &&
+        a.baseUrl === b.baseUrl
+    );
+
+    if (radarrServers.length === 0) {
+      logger.debug('No Radarr servers configured for exclusion removal sync', {
+        label: 'Blocklist Sync Removals',
